<circle cx="220" cy="180" r="38" fill="#1a1a1a" fill-opacity=".06" stroke="#1a1a1a" stroke-width="1"/>
<circle cx="220" cy="180" r="4" fill="#1a1a1a"/>
<text x="220" y="162" text-anchor="middle" font-size="10" font-weight="700" fill="#1a1a1a" font-family="DM Sans,sans-serif">Low-Code</text>
<text x="220" y="205" text-anchor="middle" font-size="8" fill="#5e5e5e" font-family="JetBrains Mono,monospace">Dev sprint per change</text>

